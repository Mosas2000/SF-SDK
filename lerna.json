{
  "$schema": "node_modules/lerna/schemas/lerna-schema.json",
  "version": "independent",
  "npmClient": "npm",
  "packages": ["packages/*"],
  "useWorkspaces": true,
  "command": {
    "publish": {
      "message": "chore(release): publish packages",
      "conventionalCommits": true,
      "allowBranch": ["main"]
    },
    "version": {
      "conventionalCommits": true,
      "message": "chore(release): version %s"
    }
  }
}
