{
  "name": "sfsec-sdk",
  "version": "1.0.0",
  "private": true,
  "description": "Security-focused SDK for SprintFund platform on Stacks blockchain",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "lerna run build",
    "test": "lerna run test",
    "test:watch": "lerna run test:watch",
    "lint": "lerna run lint",
    "clean": "lerna run clean && lerna clean -y",
    "publish": "lerna publish",
    "version:bump": "lerna version",
    "security:audit": "npm audit --workspaces",
    "prepare": "husky install"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mosas2000/SF-SDK.git"
  },
  "keywords": [
    "stacks",
    "blockchain",
    "sdk",
    "security",
    "sprintfund",
    "governance",
    "dao"
  ],
  "author": "SFSec",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Mosas2000/SF-SDK/issues"
  },
  "homepage": "https://github.com/Mosas2000/SF-SDK#readme",
  "devDependencies": {
    "@commitlint/cli": "^18.6.1",
    "@commitlint/config-conventional": "^18.6.3",
    "husky": "^8.0.3",
    "lerna": "^8.2.4",
    "typescript": "^5.9.3",
    "vitest": "^1.6.1"
  }
}
